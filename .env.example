# Copy to .env.local for local development. In production these are set in the
# hosting platform's environment variable settings. Real values are never
# committed; .env* is gitignored.

# Canonical site URL, used for canonical links, the sitemap, robots.txt and
# Open Graph tags. It must match the host actually served in production,
# including the www prefix where one is in use: a mismatch publishes URLs that
# permanently redirect.
NEXT_PUBLIC_SITE_URL=https://www.visionexum.com

# --- Google Search Console ---
# The token from the "HTML tag" verification method, without the surrounding
# markup. Leaving it empty omits the meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Google Analytics 4 ---
# Measurement ID in the form G-XXXXXXXXXX. Leaving it empty ships the site
# without analytics; no tag is rendered and no request is made.
NEXT_PUBLIC_GA_ID=

# --- Lead notification by email (Resend) ---
# The primary notification channel. Verify a subdomain such as
# send.visionexum.com rather than the root domain: the root carries the MX and
# SPF records for the company mailboxes, and keeping the two sets of records
# apart avoids interfering with them.
RESEND_API_KEY=
LEAD_NOTIFICATION_FROM="Visio Nexum <formulario@send.visionexum.com>"
LEAD_NOTIFICATION_TO=geral@visionexum.com

# --- WhatsApp Cloud API (Meta) — optional ---
# A second notification channel alongside email. WHATSAPP_PHONE_NUMBER_ID is
# the sender registered with the API, which must be a number dedicated to it
# and cannot also be used in the consumer WhatsApp app.
# WHATSAPP_BUSINESS_NUMBER is the recipient and is unaffected: it receives the
# message as any WhatsApp user would.
#
# Requires a Meta Business Account with a WhatsApp Business Platform app, a
# verified sender number, and a pre-approved message template. Business-
# initiated messages to a number that has not messaged first require an
# approved template; free-form text is permitted only within a
# customer-initiated 24-hour session.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_TEMPLATE_NAME=novo_lead

# --- Google Calendar (Apps Script Web App) ---
# Creates the meeting event on the company calendar and sends the lead an
# invitation. The endpoint is the Apps Script deployment of
# scripts/calendar-webapp.gs, which runs as the account owning the calendar:
# a Cloud service account cannot invite attendees without domain-wide
# delegation, and organisations increasingly block service account keys
# outright (iam.disableServiceAccountKeyCreation).
#
# The URL must end in /exec and the deployment's access must be "Anyone", so
# it is unauthenticated: the secret is what authorises the request, and it
# must match the SHARED_SECRET script property on the deployment.
GOOGLE_CALENDAR_WEBAPP_URL=
GOOGLE_CALENDAR_WEBAPP_SECRET=
